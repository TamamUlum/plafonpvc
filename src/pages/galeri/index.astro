<script>
  // Filter tabs and Video Modal logic
  document.addEventListener('DOMContentLoaded', () => {
    const filterTabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab-btn');
    const videoSection = document.getElementById('video-dokumentasi-section');
    const photoSection = document.getElementById('photo-gallery-section');

    filterTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        filterTabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const filter = tab.dataset.filter;
        if (filter === 'all') {
          if (videoSection) videoSection.style.display = 'block';
          if (photoSection) photoSection.style.display = 'block';
        } else if (filter === 'video') {
          if (videoSection) {
            videoSection.style.display = 'block';
            videoSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
          if (photoSection) photoSection.style.display = 'none';
        } else if (filter === 'photo') {
          if (videoSection) videoSection.style.display = 'none';
          if (photoSection) {
            photoSection.style.display = 'block';
            photoSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });

    // Video Modal Elements
    const backdrop = document.getElementById('videoModalBackdrop');
    const closeBtn = document.getElementById('closeVideoModalBtn');
    const videoPlayer = document.getElementById('modalVideoPlayer') as HTMLVideoElement | null;
    const videoSource = document.getElementById('modalVideoSource') as HTMLSourceElement | null;
    const modalTitle = document.getElementById('modalVideoTitle');
    const modalDesc = document.getElementById('modalVideoDesc');
    const modalDetailBtn = document.getElementById('modalDetailBtn') as HTMLAnchorElement | null;

    function openModal(card: HTMLElement) {
      if (!backdrop || !videoPlayer || !videoSource) return;

      const videoSrc = card.dataset.videoSrc || '';
      const title = card.dataset.videoTitle || '';
      const desc = card.dataset.videoDesc || '';
      const detailUrl = card.dataset.detailUrl || '/galeri/';
      const detailLabel = card.dataset.detailLabel || 'Buka Halaman Terkait';

      if (modalTitle) modalTitle.textContent = title;
      if (modalDesc) modalDesc.textContent = desc;
      if (modalDetailBtn) {
        modalDetailBtn.href = detailUrl;
        modalDetailBtn.innerHTML = `${detailLabel} <svg class="icon-svg" style="width:15px;height:15px" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>`;
      }

      videoSource.src = videoSrc;
      videoPlayer.load();
      backdrop.hidden = false;
      backdrop.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      // Play video with audio enabled on direct user action
      const playPromise = videoPlayer.play();
      if (playPromise !== undefined) {
        playPromise.catch(() => {
          // Fallback if browser requires muted autoplay
          videoPlayer.muted = true;
          videoPlayer.play();
        });
      }
    }

    function closeModal() {
      if (!backdrop || !videoPlayer || !videoSource) return;
      videoPlayer.pause();
      videoPlayer.currentTime = 0;
      videoSource.src = '';
      videoPlayer.load();
      backdrop.hidden = true;
      backdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Attach click triggers to cards and play buttons
    document.querySelectorAll<HTMLElement>('.video-card').forEach(card => {
      const playBtn = card.querySelector('.video-play-btn');
      const actionBtn = card.querySelector('.btn-play-trigger');
      const thumb = card.querySelector('.video-thumb-container');

      [playBtn, actionBtn, thumb].forEach(elem => {
        elem?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          openModal(card);
        });
      });
    });

    closeBtn?.addEventListener('click', closeModal);

    backdrop?.addEventListener('click', (e) => {
      if (e.target === backdrop) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop && !backdrop.hidden) {
        closeModal();
      }
    });
  });
</script>

