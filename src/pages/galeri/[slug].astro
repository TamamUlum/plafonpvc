---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import MediaGallery from '../../components/MediaGallery.astro';
import { galleryItems, type GalleryItem } from '../../data/gallery';

export function getStaticPaths() {
  return galleryItems.map((item, index) => {
    const prevItem = index > 0 ? galleryItems[index - 1] : null;
    const nextItem = index < galleryItems.length - 1 ? galleryItems[index + 1] : null;
    return {
      params: { slug: item.slug },
      props: { item, prevItem, nextItem }
    };
  });
}

interface Props {
  item: GalleryItem;
  prevItem: GalleryItem | null;
  nextItem: GalleryItem | null;
}

const { item, prevItem, nextItem } = Astro.props;

const breadcrumbItems = [
  { label: 'Galeri', href: '/galeri/' },
  { label: item.title, href: `/galeri/${item.slug}/` }
];

const waMessage = encodeURIComponent(
  `Halo Mas Otello Griya Alfath,\nSaya melihat dokumentasi "${item.title}" di galeri website dan tertarik untuk konsultasi kebutuhan serupa untuk proyek saya.\nMohon informasi ketersediaan material dan jadwal surveinya. Terima kasih!`
);
const waLink = `https://wa.me/6282157249454?text=${waMessage}`;
---

<BaseLayout
  title={`${item.title} — Galeri Plafon PVC Solo by Griya Alfath`}
  description={item.description}
  currentPath={`/galeri/${item.slug}/`}
  image={item.image}
>
  <!-- Page Banner -->
  <section class="page-banner">
    <video autoplay muted loop playsinline poster="/images/hero/hero-plafon-main.webp" class="banner-video-bg" aria-hidden="true">
      <source src="/videos/banner-bg.mp4" type="video/mp4" />
    </video>
    <div class="banner-overlay" aria-hidden="true"></div>
    <div class="container">
      <span class="badge-sub" style="background-color: rgba(255,255,255,0.15); color: #fed7aa; margin-bottom: 0.75rem;">
        {item.category}
      </span>
      <h1 class="page-banner-title">{item.title}</h1>
      <div class="banner-meta">
        {item.location && <span class="meta-pill">📍 {item.location}</span>}
        {item.date && <span class="meta-pill">🗓️ {item.date}</span>}
      </div>
    </div>
  </section>

  <!-- Breadcrumb -->
  <Breadcrumb items={breadcrumbItems} />

  <!-- Detail Content Section -->
  <section class="section-py bg-white">
    <div class="container detail-container">
      <div class="detail-grid">
        <!-- Main Content (Left Column) -->
        <div class="detail-main">
          <!-- Marketplace-style Interactive Media Gallery -->
          <div class="gallery-media-wrapper">
            <MediaGallery media={item.media} id={`gallery-${item.id}`} />
          </div>

          <!-- Narrative / Description -->
          <div class="detail-narrative">
            <h2>Tentang Dokumentasi Ini</h2>
            <p class="lead-text">{item.description}</p>
            <p>{item.fullDescription}</p>

            {item.highlights && item.highlights.length > 0 && (
              <div class="highlights-box">
                <h3>Poin Penting &amp; Keunggulan Standar:</h3>
                <ul>
                  {item.highlights.map(hl => (
                    <li>
                      <svg class="icon-svg check-icon" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                      <span>{hl}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>

          <!-- Prev/Next Navigation -->
          <div class="page-navigation">
            {prevItem ? (
              <a href={`/galeri/${prevItem.slug}/`} class="nav-prev">
                <span class="nav-dir">&larr; Dokumentasi Sebelumnya</span>
                <span class="nav-title">{prevItem.title}</span>
              </a>
            ) : <div />}

            {nextItem ? (
              <a href={`/galeri/${nextItem.slug}/`} class="nav-next">
                <span class="nav-dir">Dokumentasi Selanjutnya &rarr;</span>
                <span class="nav-title">{nextItem.title}</span>
              </a>
            ) : <div />}
          </div>
        </div>

        <!-- Sidebar / Action Card (Right Column) -->
        <aside class="detail-sidebar">
          <div class="sidebar-card">
            <span class="sidebar-badge">Konsultasi Terkait</span>
            <h3>Konsultasi Kebutuhan Anda</h3>
            <p>Tertarik dengan layanan atau material yang ditampilkan dalam dokumentasi ini? Hubungi tim admin kami untuk informasi teknis, survei lokasi gratis, atau penawaran harga resmi.</p>
            
            <div class="sidebar-meta-list">
              <div class="sidebar-meta-item">
                <strong>Kategori:</strong>
                <span>{item.category}</span>
              </div>
              {item.location && (
                <div class="sidebar-meta-item">
                  <strong>Wilayah Layanan:</strong>
                  <span>{item.location}</span>
                </div>
              )}
              <div class="sidebar-meta-item">
                <strong>Jangkauan Layanan:</strong>
                <span>Seluruh Solo Raya (Solo, Sukoharjo, Klaten, Boyolali, Karanganyar, Wonogiri, Sragen)</span>
              </div>
            </div>

            <a href={waLink} target="_blank" rel="noopener" class="btn btn-whatsapp-green w-100">
              <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.33C9.33 7.33 9 7.41 8.74 7.69C8.47 7.96 7.74 8.64 7.74 10.05C7.74 11.45 8.77 12.81 8.91 13C9.05 13.2 10.92 16.08 13.8 17.32C14.49 17.61 15.02 17.79 15.44 17.93C16.13 18.15 16.76 18.12 17.26 18.04C17.81 17.96 18.96 17.35 19.2 16.67C19.44 16 19.44 15.41 19.37 15.3C19.3 15.19 19.11 15.12 18.82 14.98C18.53 14.84 17.11 14.14 16.85 14.05C16.59 13.95 16.4 13.91 16.21 14.2C16.02 14.5 15.48 15.12 15.31 15.3C15.15 15.5 14.99 15.52 14.7 15.37C14.41 15.23 13.49 14.93 12.4 13.96C11.55 13.2 10.98 12.27 10.82 11.98C10.65 11.7 10.8 11.54 10.95 11.4C11.08 11.27 11.24 11.06 11.39 10.89C11.53 10.72 11.58 10.6 11.68 10.4C11.77 10.2 11.72 10.03 11.65 9.89C11.58 9.74 11 8.33 10.76 7.76C10.53 7.21 10.3 7.28 10.13 7.27L9.53 7.33Z"/></svg>
              Konsultasi WhatsApp (Mas Otello)
            </a>

            <div class="sidebar-secondary-action">
              <a href="/galeri/" class="btn btn-outline w-100">
                <svg class="icon-svg" viewBox="0 0 24 24"><path fill="currentColor" d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
                Kembali ke Galeri
              </a>
            </div>

            <!-- Social Media Box in Single Gallery Sidebar -->
            <div class="sidebar-social-box">
              <span class="sc-social-title">Publikasi Harian:</span>
              <p class="sc-social-subtitle">Lihat video reels &amp; story proyek lapangan terbaru di media sosial kami:</p>
              <div class="sc-social-buttons">
                <a href="https://www.instagram.com/plafonpvcsolo/" target="_blank" rel="noopener" class="btn-side-social btn-side-ig">
                  <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                  <span>Instagram</span>
                </a>
                <a href="https://www.tiktok.com/@plafonpvcsolo" target="_blank" rel="noopener" class="btn-side-social btn-side-tt">
                  <svg class="icon-svg" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1.04-.1z"/></svg>
                  <span>TikTok</span>
                </a>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .banner-meta {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .meta-pill {
    background-color: rgba(255, 255, 255, 0.12);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    font-size: 0.875rem;
    color: #e2e8f0;
  }

  .detail-container {
    max-width: 1160px;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 3rem;
    align-items: start;
  }

  .gallery-media-wrapper {
    margin-bottom: 2rem;
  }

  .detail-narrative h2 {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 1rem;
  }

  .lead-text {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-main);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .detail-narrative p {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .highlights-box {
    background-color: var(--bg-alt);
    border-left: 4px solid var(--accent);
    padding: 1.5rem;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: 2rem 0;
  }

  .highlights-box h3 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--primary);
    margin-bottom: 1rem;
  }

  .highlights-box ul {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .highlights-box li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.95rem;
    color: var(--text-main);
    line-height: 1.45;
  }

  .check-icon {
    width: 20px;
    height: 20px;
    fill: var(--accent);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .page-navigation {
    display: flex;
    justify-content: space-between;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    gap: 1.5rem;
  }

  .nav-prev, .nav-next {
    display: flex;
    flex-direction: column;
    max-width: 45%;
    text-decoration: none;
  }

  .nav-next {
    text-align: right;
    margin-left: auto;
  }

  .nav-dir {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 0.3rem;
  }

  .nav-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--primary);
    transition: var(--transition);
  }

  .nav-prev:hover .nav-title,
  .nav-next:hover .nav-title {
    color: var(--accent);
  }

  /* Sidebar */
  .sidebar-card {
    background-color: var(--bg-alt);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    position: sticky;
    top: 90px;
  }

  .sidebar-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    background-color: var(--accent-soft);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.85rem;
  }

  .sidebar-card h3 {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .sidebar-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 1.5rem;
  }

  .sidebar-meta-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    padding: 1.25rem 0;
    margin-bottom: 1.5rem;
  }

  .sidebar-meta-item {
    display: flex;
    flex-direction: column;
    font-size: 0.85rem;
  }

  .sidebar-meta-item strong {
    color: var(--primary);
    margin-bottom: 0.15rem;
  }

  .sidebar-meta-item span {
    color: var(--text-muted);
  }

  .w-100 {
    width: 100%;
  }

  .sidebar-secondary-action {
    margin-top: 0.75rem;
  }

  .sidebar-social-box {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border-color);
  }

  .sc-social-title {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--primary);
    margin-bottom: 0.35rem;
  }

  .sc-social-subtitle {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin-bottom: 0.85rem;
  }

  .sc-social-buttons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .btn-side-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-md);
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    color: #ffffff;
    transition: var(--transition);
  }

  .btn-side-ig {
    background: linear-gradient(45deg, #f09433 0%, #dc2743 50%, #bc1888 100%);
  }

  .btn-side-ig:hover {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .btn-side-tt {
    background-color: #000000;
  }

  .btn-side-tt:hover {
    background-color: #222222;
    transform: translateY(-2px);
  }

  .btn-side-social .icon-svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }

  @media (max-width: 992px) {
    .detail-grid {
      grid-template-columns: 1fr;
    }
    .sidebar-card {
      position: static;
    }
  }
</style>
