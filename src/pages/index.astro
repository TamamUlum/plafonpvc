---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleCard from '../components/ArticleCard.astro';

import { products } from '../data/products';
import { brands } from '../data/brands';
import { services } from '../data/services';
import { projects } from '../data/projects';
import { articles } from '../data/articles';

// Show first 6 products, 4 services, 4 projects, 3 articles on homepage
const homeProducts = products.slice(0, 6);
const homeServices = services.slice(0, 4);
const homeProjects = projects.slice(0, 4);
const homeArticles = articles.slice(0, 3);
---

<BaseLayout
  title="Plafon PVC Solo by Griya Alfath — Supplier Material & Jasa Pasang Plafon Solo Raya"
  description="Distributor dan supplier material plafon PVC, gypsum, baja ringan, galvalum, serta jasa pemasangan profesional bergaransi untuk hunian dan proyek di Solo Raya."
  currentPath="/"
>
  <!-- ==========================================================================
       HERO SECTION
       ========================================================================== -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-badge">
            <span></span> Distributor &amp; Aplikator Interior Terpercaya
          </div>
          <h1 class="hero-headline">
            Solusi Plafon dan Material Konstruksi untuk <span class="highlight">Hunian &amp; Proyek Anda</span>
          </h1>
          <p class="hero-subheadline">
            Supplier material plafon PVC, gypsum, baja ringan, galvalum pasir, dan layanan pemasangan profesional untuk kebutuhan rumah tinggal, renovasi, kontraktor, serta pengadaan proyek di Solo Raya.
          </p>
          <div class="hero-actions">
            <a href="https://wa.me/6282157249454?text=Halo%20Plafon%20PVC%20Solo%20by%20Griya%20Alfath,%20saya%20ingin%20konsultasi%20kebutuhan%20plafon" class="btn btn-accent" target="_blank" rel="noopener">
              <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.33C9.33 7.33 9 7.41 8.74 7.69C8.47 7.96 7.74 8.64 7.74 10.05C7.74 11.45 8.77 12.81 8.91 13C9.05 13.2 10.92 16.08 13.8 17.32C14.49 17.61 15.02 17.79 15.44 17.93C16.13 18.15 16.76 18.12 17.26 18.04C17.81 17.96 18.96 17.35 19.2 16.67C19.44 16 19.44 15.41 19.37 15.3C19.3 15.19 19.11 15.12 18.82 14.98C18.53 14.84 17.11 14.14 16.85 14.05C16.59 13.95 16.4 13.91 16.21 14.2C16.02 14.5 15.48 15.12 15.31 15.3C15.15 15.5 14.99 15.52 14.7 15.37C14.41 15.23 13.49 14.93 12.4 13.96C11.55 13.2 10.98 12.27 10.82 11.98C10.65 11.7 10.8 11.54 10.95 11.4C11.08 11.27 11.24 11.06 11.39 10.89C11.53 10.72 11.58 10.6 11.68 10.4C11.77 10.2 11.72 10.03 11.65 9.89C11.58 9.74 11 8.33 10.76 7.76C10.53 7.21 10.3 7.28 10.13 7.27L9.53 7.33Z"/></svg>
              Konsultasi via WhatsApp
            </a>
            <a href="/produk/" class="btn btn-outline-white">
              <svg class="icon-svg" viewBox="0 0 24 24"><path fill="currentColor" d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/></svg>
              Lihat Katalog Produk
            </a>
          </div>
          <div class="hero-meta-points">
            <div class="meta-point">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              Material SNI &amp; Resmi
            </div>
            <div class="meta-point">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              Garansi Hasil Pemasangan
            </div>
            <div class="meta-point">
              <svg viewBox="0 0 24 24"><path fill="currentColor" d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              Melayani B2B &amp; B2C
            </div>
          </div>
        </div>

        <div class="hero-visual">
          <div class="hero-img-container">
            <img src="/images/hero/hero-plafon-main.webp" alt="Hasil Pemasangan Plafon PVC Modern Solo by Griya Alfath" width="580" height="440" />
          </div>
          <div class="hero-floating-card">
            <div class="floating-card-icon">
              <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
            </div>
            <div class="floating-card-text">
              <strong>Motif Lengkap &amp; Bergaransi</strong>
              <span>Pilihan brand ALFAFON, BATIK, INDOKING &amp; GOLDEN</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       TRUST BAR
       ========================================================================== -->
  <section class="trust-bar">
    <div class="container">
      <div class="trust-grid">
        <div class="trust-item">
          <div class="trust-icon-box">
            <svg class="icon-svg" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z"/></svg>
          </div>
          <div class="trust-info">
            <h4>Material Teruji</h4>
            <p>Plafon PVC tahan air, anti rayap, tidak merambatkan api.</p>
          </div>
        </div>
        <div class="trust-item">
          <div class="trust-icon-box">
            <svg class="icon-svg" viewBox="0 0 24 24"><path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/></svg>
          </div>
          <div class="trust-info">
            <h4>Aplikator Berpengalaman</h4>
            <p>Pengerjaan rapi, presisi, dan sesuai jadwal kesepakatan.</p>
          </div>
        </div>
        <div class="trust-item">
          <div class="trust-icon-box">
            <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
          </div>
          <div class="trust-info">
            <h4>Garansi Pemasangan</h4>
            <p>Setiap pemasangan didukung garansi pekerjaan resmi.</p>
          </div>
        </div>
        <div class="trust-item">
          <div class="trust-icon-box">
            <svg class="icon-svg" viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 3s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
          </div>
          <div class="trust-info">
            <h4>Retail &amp; Proyek B2B</h4>
            <p>Melayani eceran rumah tinggal hingga pengadaan skala besar.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       RINGKASAN PROFIL PERUSAHAAN
       ========================================================================== -->
  <section class="section-py bg-white">
    <div class="container">
      <div class="about-preview-grid">
        <div class="about-visual">
          <div class="about-visual-main">
            <img src="/images/dokumentasi/dok-survei-lokasi.webp" alt="Tim Griya Alfath saat survei dan instalasi plafon" width="560" height="380" />
          </div>
          <div class="about-badge-card">
            <h5>Griya Alfath</h5>
            <p>Distributor material &amp; kontraktor interior terpercaya di Solo Raya.</p>
          </div>
        </div>

        <div class="about-text">
          <span class="badge-sub">Tentang Perusahaan</span>
          <h2 class="section-title">Mitra Terpercaya Kebutuhan Plafon &amp; Konstruksi Interior</h2>
          <p>
            <strong>Plafon PVC Solo by Griya Alfath</strong> bergerak di bidang distributor, supplier, penyedia material plafon berkualitas, dan jasa pemasangan konstruksi interior. Kami hadir memberikan solusi plafon yang awet, estetik, dan ekonomis untuk beragam kebutuhan bangunan Anda.
          </p>
          <p>
            Dengan jaringan layanan yang mencakup wilayah Solo Raya (Solo, Sukoharjo, Klaten, Karanganyar, Wonogiri, Boyolali, dan Sragen), kami siap melayani pelanggan individu hingga pengadaan proyek skala besar.
          </p>

          <div class="market-target-boxes">
            <div class="target-box">
              <strong>Kebutuhan Retail (B2C)</strong>
              <span>Pemilik rumah tinggal, renovasi ruangan, dan bangunan komersial yang membutuhkan material &amp; jasa pasang rapi.</span>
            </div>
            <div class="target-box">
              <strong>Kebutuhan Proyek (B2B)</strong>
              <span>Kontraktor, developer perumahan, toko bangunan, serta pengadaan material instansi swasta dan pemerintah.</span>
            </div>
          </div>

          <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
            <a href="/tentang-kami/" class="btn btn-primary">
              Pelajari Profil Lengkap
              <svg class="icon-svg" style="width:16px;height:16px;" viewBox="0 0 24 24"><path d="M5 13h11.86l-5.43 5.43 1.42 1.42L21.14 12l-8.29-8.29-1.42 1.42 5.43 5.43H5v2z"/></svg>
            </a>
            <a href="https://wa.me/6282157249454?text=Halo%20Griya%20Alfath,%20saya%20ingin%20konsultasi%20mengenai%20material%20dan%20pemasangan%20plafon%20PVC" class="btn btn-outline" target="_blank" rel="noopener">
              <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.53 7.33C9.33 7.33 9 7.41 8.74 7.69C8.47 7.96 7.74 8.64 7.74 10.05C7.74 11.45 8.77 12.81 8.91 13C9.05 13.2 10.92 16.08 13.8 17.32C14.49 17.61 15.02 17.79 15.44 17.93C16.13 18.15 16.76 18.12 17.26 18.04C17.81 17.96 18.96 17.35 19.2 16.67C19.44 16 19.44 15.41 19.37 15.3C19.3 15.19 19.11 15.12 18.82 14.98C18.53 14.84 17.11 14.14 16.85 14.05C16.59 13.95 16.4 13.91 16.21 14.2C16.02 14.5 15.48 15.12 15.31 15.3C15.15 15.5 14.99 15.52 14.7 15.37C14.41 15.23 13.49 14.93 12.4 13.96C11.55 13.2 10.98 12.27 10.82 11.98C10.65 11.7 10.8 11.54 10.95 11.4C11.08 11.27 11.24 11.06 11.39 10.89C11.53 10.72 11.58 10.6 11.68 10.4C11.77 10.2 11.72 10.03 11.65 9.89C11.58 9.74 11 8.33 10.76 7.76C10.53 7.21 10.3 7.28 10.13 7.27L9.53 7.33Z"/></svg>
              Hubungi Tim Kami
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       KEUNGGULAN PERUSAHAAN
       ========================================================================== -->
  <section class="section-py bg-alt">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge-sub">Mengapa Memilih Kami</span>
        <h2 class="section-title">Keunggulan Layanan Plafon PVC Solo by Griya Alfath</h2>
        <p class="section-desc">
          Komitmen kami menghadirkan material pilihan berkualitas tinggi dengan pengerjaan yang teliti dan transparan.
        </p>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">
            <svg class="icon-svg" viewBox="0 0 24 24"><path d="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z"/></svg>
          </div>
          <h4>Pilihan Motif &amp; Material Lengkap</h4>
          <p>Tersedia aneka motif kayu, marmer, garis minimalis, hingga variasi lis pigura dan wall panel untuk mempercantik ruangan.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
          </div>
          <h4>Garansi Pekerjaan Pemasangan</h4>
          <p>Seluruh jasa instalasi plafon dan rangka baja ringan yang kami kerjakan didukung garansi pekerjaan agar Anda merasa tenang dan puas.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg class="icon-svg" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>
          </div>
          <h4>Estimasi RAB Transparan</h4>
          <p>Konsultasi perhitungan kebutuhan volume material dan rencana anggaran biaya (RAB) yang terperinci tanpa biaya tersembunyi.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg class="icon-svg" viewBox="0 0 24 24"><path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg>
          </div>
          <h4>Stok Terjaga &amp; Pengiriman Siap</h4>
          <p>Ketersediaan stok di gudang dan armada pengiriman mandiri memastikan suplai material ke lokasi proyek berjalan lancar tepat waktu.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg class="icon-svg" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          </div>
          <h4>Jangkauan Luas Seluruh Solo Raya</h4>
          <p>Melayani survei dan pekerjaan pemasangan di Surakarta, Sukoharjo, Klaten, Karanganyar, Wonogiri, Boyolali, hingga Sragen.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg class="icon-svg" viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/></svg>
          </div>
          <h4>Konsultasi Cepat via WhatsApp</h4>
          <p>Kemudahan berdiskusi langsung dengan tim teknis dan admin kami melalui WhatsApp untuk respon cepat atas setiap pertanyaan Anda.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       KATEGORI PRODUK
       ========================================================================== -->
  <section class="section-py bg-white" id="kategori-produk">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge-sub">Katalog Unggulan</span>
        <h2 class="section-title">Kategori Produk Material Konstruksi</h2>
        <p class="section-desc">
          Kami menyediakan berbagai jenis material plafon dan konstruksi interior berkualitas untuk kebutuhan hunian pribadi maupun proyek komersial.
        </p>
      </div>

      <div class="products-grid">
        {homeProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>

      <div class="text-center" style="margin-top: 2.75rem;">
        <a href="/produk/" class="btn btn-primary">
          Buka Katalog Produk Selengkapnya
          <svg class="icon-svg" style="width:16px;height:16px;" viewBox="0 0 24 24"><path d="M5 13h11.86l-5.43 5.43 1.42 1.42L21.14 12l-8.29-8.29-1.42 1.42 5.43 5.43H5v2z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       BRAND MITRA
       ========================================================================== -->
  <section class="section-py bg-alt">
    <div class="container">
      <div class="brand-section-inner">
        <div class="section-header text-center" style="margin-bottom: 2.5rem;">
          <span class="badge-sub">Brand Pilihan</span>
          <h2 class="section-title">Brand Produk Resmi yang Kami Sediakan</h2>
          <p class="section-desc">
            Kami bermitra dengan produsen dan brand plafon serta konstruksi ternama yang telah teruji mutunya.
          </p>
        </div>

        <div class="brands-grid">
          {brands.map((b) => (
            <div class="brand-card">
              <div class="brand-thumb">
                {b.image ? (
                  <img src={b.image} alt={`Brand ${b.name}`} loading="lazy" />
                ) : (
                  <span class="brand-thumb-placeholder">{b.initials}</span>
                )}
              </div>
              <h3 class="brand-name">{b.name}</h3>
              <span class="brand-category-badge">{b.category}</span>
            </div>
          ))}
        </div>

        <div class="text-center" style="margin-top: 2rem;">
          <a href="/brand/" class="btn btn-outline">
            Lihat Informasi Lengkap Seluruh Brand
            <svg class="icon-svg" style="width:16px;height:16px;" viewBox="0 0 24 24"><path d="M5 13h11.86l-5.43 5.43 1.42 1.42L21.14 12l-8.29-8.29-1.42 1.42 5.43 5.43H5v2z"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       LAYANAN PEMASANGAN
       ========================================================================== -->
  <section class="section-py bg-white">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge-sub">Jasa Pemasangan</span>
        <h2 class="section-title">Layanan Konstruksi Interior Profesional</h2>
        <p class="section-desc">
          Selain penyediaan material, kami menyediakan tim aplikator berpengalaman untuk pemasangan dengan hasil presisi dan bergaransi.
        </p>
      </div>

      <div class="services-grid">
        {homeServices.map((s) => (
          <ServiceCard service={s} />
        ))}
      </div>

      <div class="text-center" style="margin-top: 2.75rem;">
        <a href="/layanan/" class="btn btn-primary">
          Buka Rincian Seluruh Layanan Kami
          <svg class="icon-svg" style="width:16px;height:16px;" viewBox="0 0 24 24"><path d="M5 13h11.86l-5.43 5.43 1.42 1.42L21.14 12l-8.29-8.29-1.42 1.42 5.43 5.43H5v2z"/></svg>
        </a>
      </div>
    </div>
  </section>


  <!-- ==========================================================================
       SIMULASI BIAYA & E-KATALOG BANNER
       ========================================================================== -->
  <section class="section-py bg-alt">
    <div class="container">
      <div class="calc-teaser-banner">
        <div class="calc-teaser-content">
          <span class="badge-sub" style="background-color: rgba(255,255,255,0.15); color: #fed7aa; margin-bottom: 0.85rem;">Simulasi Biaya Online &amp; Dokumen</span>
          <h2 class="calc-teaser-title">Hitung Estimasi Biaya Pasang Plafon Rumah Anda Secara Instan</h2>
          <p class="calc-teaser-desc">
            Transparansi biaya adalah komitmen Griya Alfath. Gunakan kalkulator interaktif kami untuk mengetahui perkiraan biaya material dan jasa pemasangan terima jadi tanpa biaya tersembunyi.
          </p>
          <div class="calc-teaser-features">
            <div class="ct-feat">📐 Masukkan Dimensi Ruangan</div>
            <div class="ct-feat">💎 6 Pilihan Paket Material SNI</div>
