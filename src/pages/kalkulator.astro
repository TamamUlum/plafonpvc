  }

  .breakdown-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .breakdown-list li {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    color: var(--text-main);
  }

  .breakdown-list strong {
    color: var(--primary);
  }

  .calc-guarantees {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border-color);
