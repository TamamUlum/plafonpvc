  }

  .calc-disclaimer {
    display: block;
    font-size: 0.72rem;
    color: var(--text-muted);
    text-align: center;
    margin-top: 0.5rem;
    line-height: 1.35;
  }

  /* Guide Steps */
  .calc-guide-section {
    border-top: 1px solid var(--border-color);
    padding-top: 3.5rem;
  }

  .guide-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .guide-step-card {
