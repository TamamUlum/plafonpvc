    top: 90px;
  }

  .results-kicker {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    background-color: var(--accent-soft);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.35rem;
  }

  .results-headline {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 0.5rem;
  }

  .results-selected-pkg {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary);
    background-color: var(--bg-alt);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1.25rem;
  }

  .results-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .metric-cell {
    background-color: var(--bg-alt);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.75rem 1rem;
    text-align: center;
  }

  .metric-caption {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .metric-num {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--primary);
  }

  .metric-num small {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .price-estimate-box {
    background-color: var(--accent-soft);
    border: 1.5px dashed var(--accent);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    text-align: center;
    margin-bottom: 1.25rem;
  }

  .pe-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }

  .pe-numbers {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }

  .pe-val {
    font-size: 1.45rem;
    font-weight: 900;
    color: var(--accent);
  }

  .pe-sep {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .pe-note {
    font-size: 0.75rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.4;
  }

  /* Room Breakdown Box */
  .rooms-breakdown-box {
    background-color: var(--bg-alt);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
    border: 1px solid var(--border-color);
  }

  .rbb-header h4 {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    margin-bottom: 0.65rem;
  }

  .rbb-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    max-height: 180px;
    overflow-y: auto;
    padding-right: 0.25rem;
  }

  :global(.rbb-item) {
    display: flex;
    justify-content: space-between;
    font-size: 0.8125rem;
    color: var(--text-main);
    padding-bottom: 0.35rem;
    border-bottom: 1px dashed var(--border-color);
  }

  :global(.rbb-item:last-child) {
    border-bottom: none;
    padding-bottom: 0;
  }

  :global(.rbb-room-title) {
    font-weight: 600;
    color: var(--primary);
  }

  :global(.rbb-room-metrics) {
    color: var(--accent);
    font-weight: 700;
  }

  /* Material Breakdown */
  .material-breakdown {
    background-color: var(--bg-alt);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
  }

  .material-breakdown h4 {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--primary);
    text-transform: uppercase;
    letter-spacing: 0.03em;
