  @media (max-width: 992px) {
    .calc-grid {
      grid-template-columns: 1fr;
    }
    .results-card {
      position: static;
    }
    .guide-steps-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    :global(.room-dims-row) {
      grid-template-columns: 1fr;
    }
    :global(.room-card-top) {
      flex-wrap: wrap;
    }
  }
</style>

<!-- Multi-Room Client Calculator Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const serviceSelect = document.getElementById('calcServiceSelect');
    const roomsListContainer = document.getElementById('roomsListContainer');
    const addRoomBtn = document.getElementById('addRoomBtn');

    const addonLis = document.getElementById('addonLis');
    const addonBongkar = document.getElementById('addonBongkar');
    const dlMinus = document.getElementById('dlMinus');
    const dlPlus = document.getElementById('dlPlus');
    const dlCount = document.getElementById('dlCount');

    const selectedPkgBadge = document.getElementById('selectedPkgBadge');
    const resTotalArea = document.getElementById('resTotalArea');
    const resTotalPerimeter = document.getElementById('resTotalPerimeter');
    const resPriceMin = document.getElementById('resPriceMin');
    const resPriceMax = document.getElementById('resPriceMax');
    const roomCountBadge = document.getElementById('roomCountBadge');
    const roomsBreakdownList = document.getElementById('roomsBreakdownList');
    const mbPanels = document.getElementById('mbPanels');
    const mbHollow = document.getElementById('mbHollow');
    const mbLis = document.getElementById('mbLis');
    const calcWaBtn = document.getElementById('calcWaBtn');

    if (!serviceSelect || !roomsListContainer || !addRoomBtn || !calcWaBtn) return;

    let downlights = 4;
    let roomIdCounter = 1;

    // Room State List
    let rooms = [
      { id: roomIdCounter++, name: 'Ruang Keluarga', length: 4.00, width: 3.50 }
    ];

    function formatRupiah(num) {
      return 'Rp ' + Math.round(num).toLocaleString('id-ID');
    }

    function formatDecimal(num) {
      return num.toLocaleString('id-ID', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    // Render Room Inputs in DOM
    function renderRooms() {
      roomsListContainer.innerHTML = '';

      rooms.forEach((room, index) => {
        const area = Math.round(room.length * room.width * 100) / 100;
        const perimeter = Math.round(2 * (room.length + room.width) * 100) / 100;

        const card = document.createElement('div');
        card.className = 'room-item-card';
        card.setAttribute('data-id', room.id);

        card.innerHTML = `
          <div class="room-card-top">
            <div class="room-name-wrapper">
              <span class="room-index-pill">#${index + 1}</span>
              <input
                type="text"
                class="room-name-input"
                list="roomNameSuggestions"
                value="${room.name}"
                placeholder="Nama Ruangan..."
                aria-label="Nama Ruangan ${index + 1}"
              />
            </div>
            ${rooms.length > 1 ? `
              <button type="button" class="room-delete-btn" title="Hapus Ruangan">
                <svg class="icon-svg" style="width:14px;height:14px" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                <span>Hapus</span>
              </button>
            ` : ''}
          </div>

          <div class="room-dims-row">
            <div class="dim-input-col">
              <label class="dim-input-label">Panjang (meter)</label>
              <div class="dim-input-box">
                <input
                  type="number"
                  class="room-dim-field room-length-field"
                  min="0.5"
                  max="100"
                  step="0.05"
                  value="${room.length.toFixed(2)}"
                  required
                />
                <span class="unit-tag">m</span>
              </div>
            </div>

            <div class="dim-input-col">
              <label class="dim-input-label">Lebar (meter)</label>
              <div class="dim-input-box">
                <input
                  type="number"
                  class="room-dim-field room-width-field"
                  min="0.5"
                  max="100"
                  step="0.05"
                  value="${room.width.toFixed(2)}"
                  required
                />
                <span class="unit-tag">m</span>
              </div>
            </div>
          </div>

          <div class="room-live-pill">
            <span>Luas: <strong>${formatDecimal(area)} m²</strong></span>
            <span>Keliling: <strong>${formatDecimal(perimeter)} m</strong></span>
          </div>
        `;

        // Event Listeners for this room
        const nameInput = card.querySelector('.room-name-input');
        const lengthInput = card.querySelector('.room-length-field');
        const widthInput = card.querySelector('.room-width-field');
        const deleteBtn = card.querySelector('.room-delete-btn');

        nameInput.addEventListener('input', (e) => {
          room.name = e.target.value.trim() || `Ruangan ${index + 1}`;
          calculateAll();
        });

        lengthInput.addEventListener('input', (e) => {
          let val = parseFloat(e.target.value);
          if (isNaN(val) || val <= 0) val = 0.5;
          room.length = Math.max(0.5, Math.min(100, val));
          updateRoomPill(card, room);
          calculateAll();
        });

        widthInput.addEventListener('input', (e) => {
          let val = parseFloat(e.target.value);
          if (isNaN(val) || val <= 0) val = 0.5;
          room.width = Math.max(0.5, Math.min(100, val));
          updateRoomPill(card, room);
          calculateAll();
        });

        if (deleteBtn) {
          deleteBtn.addEventListener('click', () => {
            if (rooms.length > 1) {
              rooms = rooms.filter(r => r.id !== room.id);
              renderRooms();
              calculateAll();
            }
          });
        }

        roomsListContainer.appendChild(card);
      });
    }

    function updateRoomPill(card, room) {
      const area = Math.round(room.length * room.width * 100) / 100;
      const perimeter = Math.round(2 * (room.length + room.width) * 100) / 100;
      const pill = card.querySelector('.room-live-pill');
      if (pill) {
        pill.innerHTML = `
          <span>Luas: <strong>${formatDecimal(area)} m²</strong></span>
          <span>Keliling: <strong>${formatDecimal(perimeter)} m</strong></span>
        `;
      }
    }

    // Main Accumulator Calculation
    function calculateAll() {
      let totalArea = 0;
      let totalPerimeter = 0;
      const breakdownItems = [];

      rooms.forEach((room) => {
        const area = room.length * room.width;
        const perimeter = 2 * (room.length + room.width);
        totalArea += area;
        totalPerimeter += perimeter;

        breakdownItems.push({
          name: room.name,
          dimensions: `${formatDecimal(room.length)}m × ${formatDecimal(room.width)}m`,
          area: `${formatDecimal(area)} m²`,
          perimeter: `${formatDecimal(perimeter)} m`
        });
      });

      const selectedOpt = serviceSelect.options[serviceSelect.selectedIndex];
      const priceMin = parseFloat(selectedOpt.getAttribute('data-min') || '145000');
      const priceMax = parseFloat(selectedOpt.getAttribute('data-max') || '165000');
      const pkgName = selectedOpt.getAttribute('data-name') || 'Plafon PVC Minimalis Modern';

      // 1. Base Material & Installation Cost
      let baseMin = totalArea * priceMin;
      let baseMax = totalArea * priceMax;

      // 2. Addons Cost
      let addonsCost = 0;
      const appliedAddons = [];

      // Lis Profil: Rp 25.000 / m' (based on total perimeter)
      if (addonLis && addonLis.checked) {
        const lisCost = totalPerimeter * 25000;
        addonsCost += lisCost;
        appliedAddons.push(`Lis Profil (${formatDecimal(totalPerimeter)}m)`);
      }

      // Downlight LED: Rp 65.000 / point
      if (downlights > 0) {
        const dlCost = downlights * 65000;
        addonsCost += dlCost;
        appliedAddons.push(`${downlights} Titik Downlight LED`);
      }

      // Bongkar Plafon: Rp 25.000 / m2 (based on total area)
      if (addonBongkar && addonBongkar.checked) {
        const bongkarCost = totalArea * 25000;
        addonsCost += bongkarCost;
        appliedAddons.push(`Bongkar Plafon Lama (${formatDecimal(totalArea)}m²)`);
      }

      const grandTotalMin = baseMin + addonsCost;
      const grandTotalMax = baseMax + addonsCost;

      // 3. Physical Materials Estimation (Accumulated)
      const panelCount = Math.ceil((totalArea / 0.8) * 1.1);
      const hollowCount = Math.ceil(totalArea * 0.85);
      const lisBarangCount = Math.ceil(totalPerimeter / 4);

      // Update DOM Metrics
      selectedPkgBadge.textContent = pkgName;
      resTotalArea.innerHTML = `${formatDecimal(totalArea)} <small>m²</small>`;
      resTotalPerimeter.innerHTML = `${formatDecimal(totalPerimeter)} <small>m</small>`;
      resPriceMin.textContent = formatRupiah(grandTotalMin);
      resPriceMax.textContent = formatRupiah(grandTotalMax);

      roomCountBadge.textContent = `${rooms.length} Ruangan`;

      // Update Room Breakdown List
      roomsBreakdownList.innerHTML = '';
      breakdownItems.forEach(item => {
        const li = document.createElement('li');
        li.className = 'rbb-item';
        li.innerHTML = `
          <span class="rbb-room-title">${item.name} (${item.dimensions})</span>
          <span class="rbb-room-metrics">${item.area}</span>
        `;
        roomsBreakdownList.appendChild(li);
      });

      // Update Physical Materials
      if (mbPanels) mbPanels.textContent = `± ${panelCount} lembar`;
      if (mbHollow) mbHollow.textContent = `± ${hollowCount} batang`;
      if (mbLis) mbLis.textContent = `± ${lisBarangCount} batang`;

      // Construct Custom WhatsApp Message
      let roomsWaText = '';
      breakdownItems.forEach((b, idx) => {
        roomsWaText += `  ${idx + 1}. ${b.name}: ${b.dimensions} (${b.area}, keliling ${b.perimeter})\n`;
      });

      const addonText = appliedAddons.length > 0 ? `\n• Asesoris Tambahan: ${appliedAddons.join(', ')}` : '';

      const waMsg =
        `Halo Mas Otello Griya Alfath Solo Raya,\n` +
        `Saya telah menghitung estimasi kebutuhan material melalui kalkulator website untuk ${rooms.length} ruangan proyek:\n\n` +
        `• Paket Layanan: ${pkgName}\n` +
        `• Rincian Ruangan:\n${roomsWaText}\n` +
        `• Akumulasi Proyek: Total Luas ${formatDecimal(totalArea)} m², Total Keliling ${formatDecimal(totalPerimeter)} m` +
        `${addonText}\n` +
        `• Perkiraan Biaya Terima Jadi: ${formatRupiah(grandTotalMin)} s/d ${formatRupiah(grandTotalMax)}\n\n` +
        `Saya ingin berkonsultasi mengenai hasil perhitungannya dan menjadwalkan survei lokasi gratis ke tempat saya. Terima kasih!`;

      calcWaBtn.href = `https://wa.me/6282157249454?text=${encodeURIComponent(waMsg)}`;
    }

    // Add Room Event
    addRoomBtn.addEventListener('click', () => {
      const defaultNames = [
        'Kamar Tidur Utama',
        'Kamar Tidur 1',
        'Kamar Tidur 2',
        'Ruang Tamu',
        'Dapur',
        'Kamar Mandi',
        'Ruang Makan',
        'Teras',
        'Ruang Kerja'
      ];
      const nextName = defaultNames[(rooms.length) % defaultNames.length] || `Ruangan ${rooms.length + 1}`;
      rooms.push({
        id: roomIdCounter++,
        name: nextName,
        length: 3.50,
        width: 3.00
      });
      renderRooms();
      calculateAll();
    });

    // Control Listeners
    serviceSelect.addEventListener('change', calculateAll);
    if (addonLis) addonLis.addEventListener('change', calculateAll);
    if (addonBongkar) addonBongkar.addEventListener('change', calculateAll);

    if (dlMinus) {
      dlMinus.addEventListener('click', () => {
        if (downlights > 0) {
          downlights--;
          dlCount.textContent = downlights;
          calculateAll();
        }
      });
    }

    if (dlPlus) {
      dlPlus.addEventListener('click', () => {
        if (downlights < 50) {
          downlights++;
          dlCount.textContent = downlights;
          calculateAll();
        }
      });
    }

    // Initial render and calculation
    renderRooms();
    calculateAll();
  });
</script>
