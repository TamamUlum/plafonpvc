  <!-- Interactive Client Script for Form and Map Tabs -->
  <script is:inline>
    // Map Switcher Tabs
    const mapBtns = document.querySelectorAll('.map-nav-btn, .map-tab-btn');
    const mapPanels = document.querySelectorAll('.map-panel');

    mapBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetMapId = btn.getAttribute('data-map');
        if (!targetMapId) return;

        // Update active class on nav buttons
        document.querySelectorAll('.map-nav-btn').forEach(nb => {
          if (nb.getAttribute('data-map') === targetMapId) {
            nb.classList.add('active');
            nb.setAttribute('aria-selected', 'true');
          } else {
            nb.classList.remove('active');
            nb.setAttribute('aria-selected', 'false');
          }
        });

        // Show matching panel
        mapPanels.forEach(panel => {
          if (panel.id === targetMapId) {
            panel.classList.add('active');
          } else {
            panel.classList.remove('active');
          }
        });

        // Scroll to map section smoothly on mobile if clicked from store card
        if (btn.classList.contains('map-tab-btn')) {
          const mapSection = document.querySelector('.maps-section-container');
          if (mapSection) {
            mapSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });

    // Contact Form Handler -> WhatsApp
    const form = document.getElementById('contactForm');
    const formStatus = document.getElementById('formStatus');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('name')?.value || '';
        const phone = document.getElementById('phone')?.value || '';
        const service = document.getElementById('service')?.value || '';
        const message = document.getElementById('message')?.value || '';

        const text = `Halo Mas Otello Griya Alfath,\n\nSaya ingin konsultasi melalui formulir website:\n• Nama: ${name}\n• No WA: ${phone}\n• Kebutuhan: ${service}\n• Catatan/Ukuran: ${message || '-'}\n\nMohon info dan penawaran harganya. Terima kasih!`;
        const waUrl = `https://wa.me/6282157249454?text=${encodeURIComponent(text)}`;

        if (formStatus) {
          formStatus.textContent = 'Mengarahkan ke WhatsApp Mas Otello...';
          formStatus.className = 'form-status success';
          formStatus.style.display = 'block';
        }

        setTimeout(() => {
          window.open(waUrl, '_blank');
        }, 500);
      });
    }
  </script>
</BaseLayout>

