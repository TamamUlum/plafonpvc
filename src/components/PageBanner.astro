---
interface Props {
  badge?: string;
  title: string;
  description?: string;
  videoSrc?: string;
  fallbackImage?: string;
}

const {
  badge,
  title,
  description,
  videoSrc = "/videos/banner-bg.mp4",
  fallbackImage = "/images/hero/hero-plafon-main.webp"
} = Astro.props;
---

<section class="page-banner video-banner">
  {videoSrc && (
    <video
      autoplay
      muted
      loop
      playsinline
      poster={fallbackImage}
      class="banner-video-bg"
      aria-hidden="true"
    >
      <source src={videoSrc} type="video/mp4" />
    </video>
  )}
  <div class="banner-overlay" aria-hidden="true"></div>
  <div class="container banner-inner">
    {badge && <span class="badge-sub banner-badge">{badge}</span>}
    <h1 class="page-banner-title">{title}</h1>
    {description && <p class="page-banner-desc">{description}</p>}
    <slot />
  </div>
</section>

<style>
  .video-banner {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #091a2c 0%, #0f2b48 60%, #153960 100%);
    color: #ffffff;
    padding: 4.5rem 0;
    text-align: center;
  }

  .banner-video-bg {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate(-50%, -50%);
    z-index: 1;
    opacity: 0.35;
    pointer-events: none;
  }

  .banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(9, 26, 44, 0.88) 0%, rgba(15, 43, 72, 0.82) 100%);
    z-index: 2;
  }

  .banner-inner {
    position: relative;
    z-index: 3;
    max-width: 820px;
    margin: 0 auto;
  }

  .banner-badge {
    background-color: rgba(255, 255, 255, 0.15);
    color: #fed7aa;
    margin-bottom: 0.85rem;
    backdrop-filter: blur(4px);
  }

  .page-banner-title {
    font-size: clamp(2rem, 3.8vw, 2.75rem);
    font-weight: 800;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: #ffffff;
  }

  .page-banner-desc {
    font-size: 1.075rem;
    color: #e2e8f0;
    line-height: 1.6;
    max-width: 680px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
    .video-banner {
      padding: 3.5rem 0;
    }
  }
</style>

