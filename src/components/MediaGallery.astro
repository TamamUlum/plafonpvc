---
export interface MediaItem {
  type: 'image' | 'video';
  src: string;
  thumbnail?: string;
  alt?: string;
  caption?: string;
}

interface Props {
  media: MediaItem[];
  id?: string;
}

const { media = [], id = 'mediaGallery' } = Astro.props;
const initialMedia = media && media.length > 0 ? media[0] : null;
---

<div class="marketplace-media-gallery" id={id} data-media-count={media.length}>
  <!-- Main Display Screen -->
  <div class="main-screen-wrapper">
    <!-- Image Display -->
    <div class={`main-media-box image-box ${initialMedia?.type === 'image' ? 'active' : ''}`} id={`${id}-imgBox`}>
      <button
        type="button"
        id={`${id}-lightboxTrigger`}
        class="main-img-anchor"
        aria-label="Perbesar foto tampilan utama"
      >
        <img
          id={`${id}-mainImg`}
          src={initialMedia?.type === 'image' ? initialMedia.src : ''}
          alt={initialMedia?.alt || 'Media Tampilan Utama'}
          class="main-display-image"
          width="800"
          height="500"
        />
        <span class="zoom-pill" aria-hidden="true">
          <svg class="icon-svg" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 14z"/></svg>
          <span>Perbesar Foto</span>
        </span>
      </button>
    </div>

    <!-- Video Display -->
    <div class={`main-media-box video-box ${initialMedia?.type === 'video' ? 'active' : ''}`} id={`${id}-videoBox`}>
      <video
        id={`${id}-mainVideo`}
        controls
        playsinline
        class="main-display-video"
      >
        <source src={initialMedia?.type === 'video' ? initialMedia.src : ''} type="video/mp4" />
        Browser Anda tidak mendukung pemutar video HTML5.
      </video>
    </div>
  </div>

  <!-- Thumbnails Strip -->
  {media && media.length > 1 && (
    <div class="thumbnails-track-wrapper">
      <button
        type="button"
        class="thumb-nav-btn prev"
        id={`${id}-thumbPrev`}
        aria-label="Geser thumbnail ke kiri"
      >
        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
      </button>

      <div class="thumbnails-scroll-strip" id={`${id}-thumbStrip`} role="tablist" aria-label="Daftar Thumbnail Media">
        {media.map((item, index) => {
          const thumbSrc = item.thumbnail || (item.type === 'image' ? item.src : '/images/hero/hero-plafon-main.webp');
          const isVid = item.type === 'video';

          return (
            <button
              type="button"
              class={`thumb-btn ${index === 0 ? 'active' : ''}`}
              data-index={index}
              data-type={item.type}
              data-src={item.src}
              data-alt={item.alt || ''}
              data-caption={item.caption || item.alt || ''}
              aria-label={`Pilih media ${index + 1}: ${item.alt || item.type}`}
              role="tab"
              aria-selected={index === 0 ? 'true' : 'false'}
            >
              <img src={thumbSrc} alt={item.alt || `Thumbnail ${index + 1}`} loading="lazy" />
              {isVid && (
                <span class="video-play-indicator" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
                </span>
              )}
            </button>
          );
        })}
      </div>

      <button
        type="button"
        class="thumb-nav-btn next"
        id={`${id}-thumbNext`}
        aria-label="Geser thumbnail ke kanan"
      >
        <svg class="icon-svg" viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
      </button>
    </div>
  )}

  <!-- Built-In Swipeable Reusable Lightbox Modal -->
  <div class="gallery-lightbox-modal" id={`${id}-lightboxModal`} aria-hidden="true" role="dialog" aria-label="Pratinjau Media Layar Penuh">
    <div class="lightbox-overlay" id={`${id}-lightboxOverlay`}></div>

    <div class="lightbox-container">
      <!-- Lightbox Header: Counter & Close -->
      <div class="lightbox-header">
        <div class="lightbox-counter" id={`${id}-lightboxCounter`}>
          <span class="lb-curr">1</span> / <span class="lb-total">{media.length}</span>
        </div>

        <button type="button" class="lightbox-close-btn" id={`${id}-lightboxClose`} aria-label="Tutup pratinjau">
          <svg class="icon-svg" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
        </button>
      </div>

      <!-- Lightbox Main Media Viewport -->
      <div class="lightbox-viewport" id={`${id}-lightboxViewport`}>
        <!-- Prev Button -->
        <button type="button" class="lightbox-nav-btn lb-prev" id={`${id}-lbPrev`} aria-label="Media Sebelumnya">
          <svg class="icon-svg" viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
        </button>

        <!-- Media Stage -->
        <div class="lightbox-stage" id={`${id}-lightboxStage`}>
          <img id={`${id}-lbImg`} src="" alt="Pratinjau foto besar" class="lightbox-img active" />
          <video id={`${id}-lbVideo`} controls playsinline class="lightbox-video">
            <source src="" type="video/mp4" />
          </video>
        </div>

        <!-- Next Button -->
        <button type="button" class="lightbox-nav-btn lb-next" id={`${id}-lbNext`} aria-label="Media Selanjutnya">
          <svg class="icon-svg" viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </button>
      </div>

      <!-- Caption -->
      <div class="lightbox-caption-box">
        <p class="lightbox-caption-text" id={`${id}-lbCaption`}></p>
      </div>
    </div>
  </div>
</div>

<style>
  .marketplace-media-gallery {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  /* Main Screen */
  .main-screen-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 480px;
    background-color: #091a2c;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border-color);
  }

  .main-media-box {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .main-media-box.active {
    display: flex;
  }

  .main-img-anchor {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
    cursor: zoom-in;
    background: transparent;
    border: none;
    padding: 0;
  }

  .main-display-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .main-img-anchor:hover .main-display-image {
    transform: scale(1.025);
  }

  .zoom-pill {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    background-color: rgba(15, 43, 72, 0.85);
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .main-display-video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background-color: #000000;
  }

  /* Thumbnails Track */
  .thumbnails-track-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .thumbnails-scroll-strip {
    display: flex;
    gap: 0.65rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding: 0.25rem 0.15rem;
    scrollbar-width: thin;
    scrollbar-color: var(--accent) transparent;
    flex-grow: 1;
  }

  .thumbnails-scroll-strip::-webkit-scrollbar {
    height: 6px;
  }

  .thumbnails-scroll-strip::-webkit-scrollbar-thumb {
    background-color: var(--accent);
    border-radius: 9999px;
  }

  .thumb-btn {
    position: relative;
    width: 84px;
    height: 64px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 2px solid var(--border-color);
    background-color: #1e293b;
    padding: 0;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.75;
    transition: opacity 0.2s ease;
  }

  .thumb-btn:hover {
    border-color: var(--accent);
  }

  .thumb-btn:hover img {
    opacity: 1;
  }

  .thumb-btn.active {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent-soft);
  }

  .thumb-btn.active img {
    opacity: 1;
  }

  .video-play-indicator {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 26px;
    height: 26px;
    background-color: rgba(230, 81, 0, 0.9);
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .video-play-indicator svg {
    width: 14px;
    height: 14px;
    margin-left: 2px;
  }

  /* Navigation Buttons */
  .thumb-nav-btn {
    width: 32px;
    height: 64px;
    border: 1px solid var(--border-color);
    background-color: #ffffff;
    color: var(--primary);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: var(--transition);
  }

  .thumb-nav-btn:hover:not(:disabled) {
    background-color: var(--accent);
    color: #ffffff;
    border-color: var(--accent);
  }

  .thumb-nav-btn:disabled,
  .thumb-nav-btn.is-disabled {
    opacity: 0.3;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* Lightbox Modal */
  .gallery-lightbox-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 99999;
    align-items: center;
    justify-content: center;
  }

  .gallery-lightbox-modal.active {
    display: flex;
  }

  .lightbox-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(5, 15, 26, 0.92);
    backdrop-filter: blur(8px);
  }

  .lightbox-container {
    position: relative;
    z-index: 2;
    width: 94%;
    max-width: 1100px;
    height: 90vh;
    display: flex;
    flex-direction: column;
  }

  .lightbox-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0;
    color: #ffffff;
  }

  .lightbox-counter {
    font-size: 0.95rem;
    font-weight: 700;
    background-color: rgba(255, 255, 255, 0.12);
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-full);
  }

  .lightbox-close-btn {
    background: rgba(255, 255, 255, 0.15);
    border: none;
    color: #ffffff;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition);
  }

  .lightbox-close-btn:hover {
    background-color: var(--accent);
    transform: rotate(90deg);
  }

  .lightbox-viewport {
    position: relative;
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .lightbox-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background-color: rgba(15, 43, 72, 0.75);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition);
  }

  .lightbox-nav-btn:hover {
    background-color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-50%) scale(1.1);
  }

  .lb-prev { left: 1rem; }
  .lb-next { right: 1rem; }

  .lightbox-stage {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    user-select: none;
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--radius-md);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    display: none;
  }

  .lightbox-img.active {
    display: block;
  }

  .lightbox-video {
    max-width: 100%;
    max-height: 100%;
    border-radius: var(--radius-md);
    display: none;
    background-color: #000000;
  }

  .lightbox-video.active {
    display: block;
  }

  .lightbox-caption-box {
    text-align: center;
    padding: 0.75rem 1rem;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: var(--radius-md);
    margin-top: 0.5rem;
  }

  .lightbox-caption-text {
    font-size: 0.9rem;
    color: #e2e8f0;
    margin: 0;
  }

  @media (max-width: 640px) {
    .main-screen-wrapper {
      max-height: 280px;
    }
    .thumb-btn {
      width: 68px;
      height: 52px;
    }
    .thumb-nav-btn {
      width: 24px;
      height: 52px;
    }
    .lightbox-nav-btn {
      width: 38px;
      height: 38px;
    }
    .lb-prev { left: 0.5rem; }
    .lb-next { right: 0.5rem; }
  }
</style>

<!-- Reusable Client Script for Media Gallery, Arrows & Lightbox Swipe -->
<script is:inline define:vars={{ id, media }}>
  document.addEventListener('DOMContentLoaded', () => {
    const galleryEl = document.getElementById(id);
    if (!galleryEl || !media || media.length === 0) return;

    // Gallery Elements
    const imgBox = document.getElementById(`${id}-imgBox`);
    const videoBox = document.getElementById(`${id}-videoBox`);
    const mainImg = document.getElementById(`${id}-mainImg`);
    const mainVideo = document.getElementById(`${id}-mainVideo`);
    const lightboxTrigger = document.getElementById(`${id}-lightboxTrigger`);

    const thumbStrip = document.getElementById(`${id}-thumbStrip`);
    const thumbPrev = document.getElementById(`${id}-thumbPrev`);
    const thumbNext = document.getElementById(`${id}-thumbNext`);
    const thumbButtons = galleryEl.querySelectorAll('.thumb-btn');

    // Lightbox Elements
    const lbModal = document.getElementById(`${id}-lightboxModal`);
    const lbOverlay = document.getElementById(`${id}-lightboxOverlay`);
    const lbClose = document.getElementById(`${id}-lightboxClose`);
    const lbPrev = document.getElementById(`${id}-lbPrev`);
    const lbNext = document.getElementById(`${id}-lbNext`);
    const lbImg = document.getElementById(`${id}-lbImg`);
    const lbVideo = document.getElementById(`${id}-lbVideo`);
    const lbCaption = document.getElementById(`${id}-lbCaption`);
    const lbCounter = document.getElementById(`${id}-lightboxCounter`);
    const lbStage = document.getElementById(`${id}-lightboxStage`);

    let currentIndex = 0;

    // 1. Set Active Media on Main Screen
    function setActiveMedia(index, syncLightbox = false) {
      if (index < 0) index = 0;
      if (index >= media.length) index = media.length - 1;
      currentIndex = index;

      // Update thumbnails active state
      thumbButtons.forEach((btn, idx) => {
        if (idx === index) {
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
          // Ensure active thumbnail is scrolled into view
          if (thumbStrip) {
            const btnLeft = btn.offsetLeft;
            const btnWidth = btn.offsetWidth;
            const stripLeft = thumbStrip.scrollLeft;
            const stripWidth = thumbStrip.clientWidth;

            if (btnLeft < stripLeft) {
              thumbStrip.scrollTo({ left: btnLeft - 10, behavior: 'smooth' });
            } else if (btnLeft + btnWidth > stripLeft + stripWidth) {
              thumbStrip.scrollTo({ left: btnLeft + btnWidth - stripWidth + 10, behavior: 'smooth' });
            }
          }
        } else {
          btn.classList.remove('active');
          btn.setAttribute('aria-selected', 'false');
        }
      });

      const item = media[index];
      if (!item) return;

      if (item.type === 'image') {
        if (mainVideo) {
          mainVideo.pause();
        }
        if (videoBox) videoBox.classList.remove('active');
        if (imgBox) imgBox.classList.add('active');

        if (mainImg) {
          mainImg.src = item.src;
          mainImg.alt = item.alt || 'Media Foto';
        }
      } else if (item.type === 'video') {
        if (imgBox) imgBox.classList.remove('active');
        if (videoBox) videoBox.classList.add('active');

        if (mainVideo) {
          mainVideo.src = item.src;
          mainVideo.load();
        }
      }

      if (syncLightbox && lbModal && lbModal.classList.contains('active')) {
        updateLightboxContent(index);
      }
    }

    // 2. Thumbnail Strip Scrolling & Arrow State Maintenance
    function updateArrowStates() {
      if (!thumbStrip || !thumbPrev || !thumbNext) return;

      const maxScrollLeft = thumbStrip.scrollWidth - thumbStrip.clientWidth;

      if (maxScrollLeft <= 2) {
        thumbPrev.style.display = 'none';
        thumbNext.style.display = 'none';
        return;
      }

      thumbPrev.style.display = 'flex';
      thumbNext.style.display = 'flex';

      if (thumbStrip.scrollLeft <= 4) {
        thumbPrev.classList.add('is-disabled');
        thumbPrev.disabled = true;
      } else {
        thumbPrev.classList.remove('is-disabled');
        thumbPrev.disabled = false;
      }

      if (thumbStrip.scrollLeft >= maxScrollLeft - 4) {
        thumbNext.classList.add('is-disabled');
        thumbNext.disabled = true;
      } else {
        thumbNext.classList.remove('is-disabled');
        thumbNext.disabled = false;
      }
    }

    if (thumbStrip) {
      thumbStrip.addEventListener('scroll', updateArrowStates, { passive: true });
      window.addEventListener('resize', updateArrowStates);
      setTimeout(updateArrowStates, 300);
    }

    if (thumbPrev && thumbStrip) {
      thumbPrev.addEventListener('click', (e) => {
        e.stopPropagation();
        thumbStrip.scrollBy({ left: -220, behavior: 'smooth' });
        setTimeout(updateArrowStates, 350);
      });
    }

    if (thumbNext && thumbStrip) {
      thumbNext.addEventListener('click', (e) => {
        e.stopPropagation();
        thumbStrip.scrollBy({ left: 220, behavior: 'smooth' });
        setTimeout(updateArrowStates, 350);
      });
    }

    thumbButtons.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        setActiveMedia(idx);
      });
    });

    // 3. Lightbox Functions
    function openLightbox(index = currentIndex) {
      if (!lbModal) return;
      currentIndex = index;
      lbModal.classList.add('active');
      lbModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden'; // prevent page scroll
      updateLightboxContent(index);
    }

    function closeLightbox() {
      if (!lbModal) return;
      lbModal.classList.remove('active');
      lbModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lbVideo) {
        lbVideo.pause();
      }
    }

    function updateLightboxContent(index) {
      const item = media[index];
      if (!item) return;

      if (lbCounter) {
        lbCounter.innerHTML = `<span class="lb-curr">${index + 1}</span> / <span class="lb-total">${media.length}</span>`;
      }

      if (lbCaption) {
        lbCaption.textContent = item.caption || item.alt || `Media ${index + 1}`;
      }

      if (item.type === 'image') {
        if (lbVideo) {
          lbVideo.pause();
          lbVideo.classList.remove('active');
        }
        if (lbImg) {
          lbImg.src = item.src;
          lbImg.alt = item.alt || 'Foto Pratinjau';
          lbImg.classList.add('active');
        }
      } else if (item.type === 'video') {
        if (lbImg) {
          lbImg.classList.remove('active');
        }
        if (lbVideo) {
          lbVideo.src = item.src;
          lbVideo.classList.add('active');
          lbVideo.load();
        }
      }

      // Sync gallery thumbnails
      setActiveMedia(index, false);
    }

    function lightboxPrev() {
      const prevIdx = (currentIndex - 1 + media.length) % media.length;
      updateLightboxContent(prevIdx);
    }

    function lightboxNext() {
      const nextIdx = (currentIndex + 1) % media.length;
      updateLightboxContent(nextIdx);
    }

    // Lightbox Event Listeners
    if (lightboxTrigger) {
      lightboxTrigger.addEventListener('click', () => {
        openLightbox(currentIndex);
      });
    }

    if (lbClose) lbClose.addEventListener('click', closeLightbox);
    if (lbOverlay) lbOverlay.addEventListener('click', closeLightbox);
    if (lbPrev) lbPrev.addEventListener('click', lightboxPrev);
    if (lbNext) lbNext.addEventListener('click', lightboxNext);

    // Keyboard Navigation
    document.addEventListener('keydown', (e) => {
      if (!lbModal || !lbModal.classList.contains('active')) return;

      if (e.key === 'Escape') {
        closeLightbox();
      } else if (e.key === 'ArrowLeft') {
        lightboxPrev();
      } else if (e.key === 'ArrowRight') {
        lightboxNext();
      }
    });

    // Touch Swipe Gestures for Mobile
    let touchStartX = 0;
    let touchStartY = 0;
    let touchEndX = 0;
    let touchEndY = 0;

    if (lbStage) {
      lbStage.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
      }, { passive: true });

      lbStage.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        touchEndY = e.changedTouches[0].screenY;
        handleSwipe();
      }, { passive: true });
    }

    function handleSwipe() {
      const deltaX = touchEndX - touchStartX;
      const deltaY = touchEndY - touchStartY;

      // Threshold: minimum 45px swipe, and horizontal swipe must dominate vertical swipe
      if (Math.abs(deltaX) > 45 && Math.abs(deltaX) > Math.abs(deltaY) * 1.5) {
        if (deltaX < 0) {
          // Swipe Left -> Next
          lightboxNext();
        } else {
          // Swipe Right -> Prev
          lightboxPrev();
        }
      }
    }
  });
</script>
